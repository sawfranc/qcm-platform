# Base de données
DATABASE_URL="postgresql://qcm_user:qcm_password@localhost:5432/qcm_platform"

# JWT
JWT_ACCESS_SECRET="change_me_access_secret"
JWT_REFRESH_SECRET="change_me_refresh_secret"
JWT_ACCESS_EXPIRES="20m"
JWT_REFRESH_EXPIRES="30d"

# Serveur
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# Paiement CinetPay (récupérés dans "Intégrations" de votre compte marchand)
CINETPAY_APIKEY="votre_apikey"
CINETPAY_SITE_ID="votre_site_id"
CINETPAY_SECRET_KEY="votre_secret_key"   # sert uniquement à vérifier le x-token des notifications

# URLs publiques nécessaires pour que CinetPay puisse vous notifier
# En développement, utilisez ngrok (ex: https://xxxx.ngrok-free.app) car CinetPay
# doit pouvoir atteindre notify_url depuis internet — localhost ne fonctionne pas.
API_PUBLIC_URL="https://xxxx.ngrok-free.app"
FRONTEND_URL="http://localhost:5173"
